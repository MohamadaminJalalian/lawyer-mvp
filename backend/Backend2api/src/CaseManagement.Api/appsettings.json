{
  "App": {
    "Name": "CaseManagementMVP",
    "Environment": "development",
    "Port": 3000
  },
  "Api": {
    "Prefix": "/api/v1"
  },
  "Jwt": {
    "Secret": "CHANGE_THIS_SECRET_KEY_IN_DEV_ONLY",
    "Issuer": "CaseManagementMVP",
    "Audience": "CaseManagementMVPClient",
