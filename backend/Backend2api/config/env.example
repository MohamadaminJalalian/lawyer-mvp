# Application
APP_NAME=CaseManagementMVP
APP_ENV=development
APP_PORT=3000
API_PREFIX=/api/v1

# JWT settings
# IMPORTANT: change JWT_SECRET in your local .env and never commit real secrets
JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN_HOURS=24
JWT_ISSUER=CaseManagementMVP
JWT_AUDIENCE=CaseManagementMVPClient

# Database (SQL Server)
DATABASE_TYPE=sqlserver
DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=case_management_mvp
DATABASE_USER=sa
DATABASE_PASSWORD=your_password

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173
